{
  "name": "hype-score",
  "version": "1.6.2",
  "private": true,
  "type": "module",
  "description": "Hype - Live Football Scores Chrome Extension & Cloudflare Worker",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "test": "node --test tests/*.test.mjs && node tools/worker-regression-test.mjs && node tools/hardening-test.mjs && node tools/analytics-dashboard-test.mjs",
    "test:fast": "node --test --test-reporter=dot tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=worker/** --test-coverage-include=extension/popup.js --test-coverage-include=tools/security-check.mjs --test-coverage-include=tools/report-test-failure.mjs tests/*.test.mjs",
    "security:check": "node tools/security-check.mjs",
    "verify": "node tools/verify.mjs",
    "test:i18n": "node tools/audit-i18n.js && node --test tests/i18n.test.mjs",
    "test:e2e": "playwright test",
    "smoke": "node tools/smoke-test.js",
    "monitor": "node tools/production-monitor.mjs",
    "deploy": "wrangler deploy",
    "analytics": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/start-analytics-dashboard.ps1",
    "analytics:test": "node tools/analytics-dashboard-test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "happy-dom": "^21.0.4",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "undici@>=7.0.0 <7.30.1": "^7.30.1"
  }
}
